# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dairy_farm

# JWT secret — generate a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_string

# Server port (default: 5000)
PORT=5000

# SMTP email (optional — enables admin password reset + daily summaries)
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your@gmail.com, SMTP_PASS=your Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=
APP_URL=http://localhost:5000

# Daily email summary recipient(s) (optional)
EMAIL_TO=

# Legacy email variables are still supported if you already use them:
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_HOST=
# EMAIL_PORT=

# Frontend URL for CORS (restrict in production, leave blank for dev = allow all)
FRONTEND_URL=

# Cron endpoint secret (optional — for automated daily email via external scheduler)
CRON_SECRET=
