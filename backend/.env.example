# MongoDB connection string (required)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dairy_farm

# JWT login secret (required) — use any long random text
JWT_SECRET=change_me_to_a_random_string

# JWT session lifetime (optional; default is 7d)
JWT_EXPIRES_IN=7d

# Backend API port for local development.
# The frontend Vite server runs on 5000 and proxies /api to backend port 3000.
PORT=3000

# SMTP email for admin forgot-password reset codes (optional but needed for Forgot Password)
# Gmail example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM=
APP_URL=http://localhost:5000

# Daily email summary recipient(s) (optional; not required for forgot password)
EMAIL_TO=

# Frontend URL for CORS (optional; leave blank for local dev)
FRONTEND_URL=

# Cron endpoint secret (optional; for automated daily email via external scheduler)
CRON_SECRET=
